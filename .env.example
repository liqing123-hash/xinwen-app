# 生成 VAPID 密钥: npm run generate-vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# 服务端口
PORT=3000

# 时区 (定时任务依赖此配置)
TZ=Asia/Shanghai

# 邮件推送 (QQ邮箱: smtp.qq.com / 163: smtp.163.com / Gmail: smtp.gmail.com)
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=你的邮箱@qq.com
SMTP_PASS=授权码（非登录密码，在邮箱设置中生成）
MAIL_TO=接收通知的邮箱@xxx.com
